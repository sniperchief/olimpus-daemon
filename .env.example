# Required by dist/config.js (used by the bridge script)
ANTHROPIC_API_KEY=
MODEL_ID=claude-haiku-4-5

# Must point at the ALREADY-DEPLOYED Olimpus Council engine (a separate Railway
# service) — this container does not run that server itself, it only calls it.
PUBLIC_URL=https://olimpus-production.up.railway.app/

# Set as a Railway secret, not here: CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`,
# run locally) — lets the Claude Code CLI authenticate headlessly in this container.
